{
  // Tidewall: one Worker serves the dashboard (static files) and the API.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tidewall",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-15",
  "assets": {
    "directory": "../dashboard",
    "binding": "ASSETS",
    "not_found_handling": "404-page"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tidewall",
      "database_id": "23f1d327-2ec2-453e-a67e-0ebc39c5bdc6",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    // Cloudflare Access for /me and /api/me. Not secrets: Access publishes both.
    "ACCESS_TEAM_DOMAIN": "winter-bread-4f16.cloudflareaccess.com",
    "ACCESS_AUD": "bd6d09b8f108cd33bb9a96a8f06bb58653a8aab1a4acee201198e24ca7ddc246"
  },
  // KEY_ENC_SECRET is a Worker secret, created once by the deploy workflow.
  "observability": { "enabled": true }
}
